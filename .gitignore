# ── 私钥与签名：绝不入库 ──────────────────────────────────────────────────
*.keystore
*.jks
*.pk8
*.pem

# ── 构建产物 ──────────────────────────────────────────────────────────────
out/
apk/assets/dashcast-agent.jar
# Same rule for the netease fork: a pattern with a slash *inside* it is anchored to this
# directory, so the line above does not cover netease/apk/assets/dashcast-agent.jar
# (that one is copied in by the fork's own build.ps1).
netease/apk/assets/dashcast-agent.jar
*.apk
*.idsig

# ── 本地工作目录（抓帧、反编译等一次性产物）─────────────────────────────
work/
decompiled/

# ── 脚本缓存与日志 ────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.log
