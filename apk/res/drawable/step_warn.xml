<?xml version="1.0" encoding="utf-8"?>
<!--
  免责声明里「重点条目」的编号圆点（3 注意驾驶安全 / 4 按现状提供）。
  用 warn 琥珀而不是 accent 蓝：这两条是"要看进去"的提醒，不是流程步骤；
  与状态行的 warn 圆点同色，同一套语义色在全应用只表示一件事。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@android:color/transparent" />
    <stroke
        android:width="1.5px"
        android:color="@color/warn" />
</shape>
