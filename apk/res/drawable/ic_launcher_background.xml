<?xml version="1.0" encoding="utf-8"?>
<!--
  自适应图标 · 背景层。

  满幅 108×108 纯色，被系统遮罩裁切 —— 所以这里不能有任何需要保住位置的内容。
  颜色与前景层是唯一的一组配色：蓝底 + 白图形，两个颜色，不用渐变、不用光晕。

  108×108 是自适应图标的固定画布；系统只保证中间 72×72（含圆形遮罩下的内切区）可见，
  所以有位置要求的内容全部放在前景层里，背景层只负责铺底。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#1B62D6"
        android:pathData="M0,0 L108,0 L108,108 L0,108 Z" />
</vector>
