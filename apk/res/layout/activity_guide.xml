<?xml version="1.0" encoding="utf-8"?>
<!--
  ADB 授权引导页。对应设计预览页 `dashcast-design-preview.html` 的 S5。

  版式：整屏铺 bg，中间一张 1040px 宽的卡片（panel 底 + line 描边 + 10px 圆角）。
  从 h3 到 gactions 的间距照抄预览页：12 / 36 / 34 / 34。

  三步步进条是**静态**的：这一页只在"还没授权"时才会真正被看到，而那时流程必然停在
  第 2 步，所以画成动态的没有意义。动态的只有标题、说明与右下角状态。

  外层 ScrollView + fillViewport：内容装得下时它就是预览页里那块居中的 907px 区域，
  装不下时（代理启动失败会把整段输出贴进说明里）能滚，而不是被裁掉。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="1440px"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/guide_card"
            android:orientation="vertical"
            android:paddingLeft="52px"
            android:paddingTop="48px"
            android:paddingRight="52px"
            android:paddingBottom="48px">

        <TextView
            android:id="@+id/guideTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/guide_title"
            android:textColor="@color/t1"
            android:textSize="38px"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/guideSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12px"
            android:lineSpacingMultiplier="1.4"
            android:text="@string/guide_sub"
            android:textColor="@color/t2"
            android:textSize="24px" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36px"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="72px"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="34px"
                    android:layout_height="34px"
                    android:background="@drawable/step_done"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/guide_step1_n"
                    android:textColor="@color/on_ok"
                    android:textSize="19px"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20px"
                    android:text="@string/guide_step1"
                    android:textColor="@color/t2"
                    android:textSize="24px" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="72px"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="34px"
                    android:layout_height="34px"
                    android:background="@drawable/step_cur"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/guide_step2_n"
                    android:textColor="@color/accent"
                    android:textSize="19px"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20px"
                    android:text="@string/guide_step2"
                    android:textColor="@color/t1"
                    android:textSize="24px" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="72px"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="34px"
                    android:layout_height="34px"
                    android:background="@drawable/step_todo"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/guide_step3_n"
                    android:textColor="@color/t3"
                    android:textSize="19px" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20px"
                    android:text="@string/guide_step3"
                    android:textColor="@color/t2"
                    android:textSize="24px" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/guideDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="34px"
            android:background="@drawable/guide_note"
            android:lineSpacingMultiplier="1.5"
            android:paddingLeft="20px"
            android:textColor="@color/t3"
            android:textSize="21px" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="34px"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnAuthorize"
                style="@style/Btn.Primary"
                android:layout_width="wrap_content"
                android:layout_height="72px"
                android:text="@string/guide_start" />

            <Button
                android:id="@+id/btnRetry"
                style="@style/Btn.Flat"
                android:layout_width="wrap_content"
                android:layout_height="72px"
                android:layout_marginLeft="14px"
                android:text="@string/guide_retry" />

            <View
                android:layout_width="0dp"
                android:layout_height="1px"
                android:layout_weight="1" />

            <View
                android:id="@+id/guideDot"
                android:layout_width="11px"
                android:layout_height="11px"
                android:background="@drawable/dot" />

            <TextView
                android:id="@+id/guideStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="11px"
                android:textColor="@color/t2"
                android:textSize="24px" />
        </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</ScrollView>
