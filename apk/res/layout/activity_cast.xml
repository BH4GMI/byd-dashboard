<?xml version="1.0" encoding="utf-8"?>
<!--
  主屏上的仪表盘管理界面。

  根是**竖向 LinearLayout**：预览区 weight=1 占满操作条以上的空间，操作条是它的兄弟。
  这样预览的居中发生在"操作条以上的那块空间"里，不需要任何魔法数字。

  之前根是 FrameLayout + 操作条 layout_gravity="bottom"，两者互相叠加：
  预览 center_vertical 落在 y=177..897，操作条从 y=894 起把最下 3 行盖住
  （操作条半透明，实测那 3 行的画面被衰减到剩余 5.9%）。改成本结构后 720 行全部可见，
  而且操作条高度将来一变，预览自动跟随，不会重新压上去。

  **预览区内部子视图顺序是有意义的，不要调整**（已实测）：
    预览(TextureView) → 预览降级(ImageView) → 触控板(touchPanel) → 应用面板
  触控板必须压在预览之上、应用面板之下。早期把触控板写成裸 View 时
  onTouch 完全不触发，改成带背景的 FrameLayout 并保持这个顺序后才通。
  两个预览视图重叠、**互斥显示**（同一时刻只有一个 visible），先后无所谓，
  但都要待在触控板之下。

  预览区是 1:1 的 1920x720 版式，与仪表屏同尺寸，所以触控板的 View 局部坐标
  就是仪表屏坐标，不需要任何换算。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/stage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!--
          主预览：GPU 直通。uid 2000 的特权进程把仪表盘那块屏（display 2）的 layerStack
          挂到它新建的 SurfaceControl display 上，再把输出接到本视图的 Surface ——
          没有抓帧、没有编码、没有 CPU 回读。这也是原版 Just Dashboard 的做法。
        -->
        <TextureView
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="720px"
            android:layout_gravity="center_vertical"
            android:contentDescription="@string/preview_desc" />

        <!--
          降级预览：特权进程起不来、或它拒绝这块 Surface 时改用 screencap 抓帧
          （实测 3.2~3.5 fps）。**默认 gone**，由界面在两个视图之间显式切换 ——
          不靠"空 TextureView 会透出底下"这种厂商相关的行为，不能赌。
        -->
        <ImageView
            android:id="@+id/previewFallback"
            android:layout_width="match_parent"
            android:layout_height="720px"
            android:layout_gravity="center_vertical"
            android:contentDescription="@string/preview_desc"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/touchPanel"
            android:layout_width="match_parent"
            android:layout_height="720px"
            android:layout_gravity="center_vertical"
            android:background="#1A2E9BFF">

            <TextView
                android:id="@+id/touchHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="@string/touchpad_hint"
                android:textColor="#80FFFFFF"
                android:textSize="22sp" />
        </FrameLayout>

        <include layout="@layout/panel_apps" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FF101418"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <TextView
            android:id="@+id/status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/status_waiting"
            android:textColor="@android:color/white"
            android:textSize="16sp" />

        <Switch
            android:id="@+id/swAuto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="8dp"
            android:text="@string/auto_short"
            android:textColor="@android:color/white"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnQuick"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/quick_prefix" />

        <Button
            android:id="@+id/btnApps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_list" />

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/back" />

        <Button
            android:id="@+id/btnHome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home" />

        <Button
            android:id="@+id/btnExit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/exit_control" />
    </LinearLayout>
</LinearLayout>
