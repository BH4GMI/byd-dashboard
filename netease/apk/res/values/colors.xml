<?xml version="1.0" encoding="utf-8"?>
<!--
  配色令牌。**全应用只有这一套，固定深色。**

  为什么不跟随车机日夜（没有 values-night）：这块屏就在驾驶员右手边，白底在夜间刺眼；
  而且这套深色是设计预览页里逐块对齐过的那一套，多一个主题就多一套要维护的对比度。
  因此这里**不建 values-night/**，颜色也不随系统 uiMode 变。

  与设计预览页 `dashcast-design-preview.html` 的 `:root` 逐条对应：
    bg #0E1116 · panel #151A21 · panel2 #1C222B
    line rgba(255,255,255,.07)=#12FFFFFF · line2 rgba(255,255,255,.14)=#24FFFFFF
    accent #3B82F6 · ok #3FB950 · warn #D29922 · danger #F85149
    t1 #E6EDF3 · t2 #9BA5B0 · t3 #6E7681

  布局里只允许出现 `@color/...`，不允许出现颜色字面量；层次靠底色差与描边，
  不用阴影（车机屏幕对比度低，阴影看不见还会糊掉描边）。
-->
<resources>
    <!-- 窗口底 / 栏 / 按钮 -->
    <color name="bg">#FF0E1116</color>
    <color name="panel">#FF151A21</color>
    <color name="panel2">#FF1C222B</color>

    <!-- 分隔线：低对比用 line，控件描边用 line2 -->
    <color name="line">#12FFFFFF</color>
    <color name="line2">#24FFFFFF</color>

    <!-- 全站唯一强调色 -->
    <color name="accent">#FF3B82F6</color>

    <!-- 文字三级 -->
    <color name="t1">#FFE6EDF3</color>
    <color name="t2">#FF9BA5B0</color>
    <color name="t3">#FF6E7681</color>

    <!-- 状态点 -->
    <color name="ok">#FF3FB950</color>
    <color name="warn">#FFD29922</color>
    <color name="danger">#FFF85149</color>

    <!-- 预览区：镜像未建立时的底色 -->
    <color name="preview_bg">#FF05070A</color>

    <!-- 应用列表当前一键启动目标的行底色：强调色 10% -->
    <color name="row_on">#1A3B82F6</color>

    <!-- 应用图标占位块上的字形，以及主按钮上的字：恒白（底色是饱和色/accent） -->
    <color name="tile_glyph">#FFFFFFFF</color>

    <!-- 按下涟漪 -->
    <color name="ripple">#33FFFFFF</color>

    <!-- 预览区右下角「可直接触控」：刻意很淡，只是提示不是内容 -->
    <color name="corner">#38FFFFFF</color>

    <!-- 落在 ok 绿实心圆上的字形（对应预览页 `.sitem.done .n`） -->
    <color name="on_ok">#FF0A0C10</color>
</resources>
