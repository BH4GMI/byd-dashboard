<?xml version="1.0" encoding="utf-8"?>
<!--
  应用选择浮层。对应设计预览页 `dashcast-design-preview.html` 的 S2。

  它是**盖住整个 stage 的全高浮层**（不是居中的小卡片）：从顶栏下沿一直铺到底栏上沿，
  即 activity_cast.xml 里 stage 的整个区域。铺满是有意的 —— 选应用时预览画面没有用，
  留一条缝反而让人分不清手指会落到哪一层。

  版式：头部 76px（标题 + 分段 + 关闭） / 列头 40px / 列表(weight) / 底部说明 56px。
  三列宽度 1fr : 130px : 220px 与行的 item_app.xml 必须一致，否则列头会和内容错位 ——
  这两处的数字是同一份规格的两个副本，改一处必须改另一处。

  **必须保持 activity_cast.xml 里的子视图顺序**（预览 → 触控板 → 空状态 → 提示条 → 本浮层），
  否则触控派发会被打断。

  没有搜索框：这是车机，输入法是否弹出不可靠，用「收藏 + 快速滚动」更符合驾驶场景。
  ListView 开了 fastScrollEnabled，纯触摸即可拖动定位。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/appPanel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="76px"
        android:background="@drawable/line_bottom"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="24px"
        android:paddingRight="24px">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_list_title"
            android:textColor="@color/t1"
            android:textSize="30px"
            android:textStyle="bold" />

        <!--
          分段控件。用 RadioGroup + RadioButton(button=@null) 而不是两个普通按钮：
          "当前只看收藏还是看全部"本来就是单选语义，交给原生单选机制，
          选中态由背景 selector 的 state_checked 表达，不需要在代码里维护两组颜色。
        -->
        <RadioGroup
            android:id="@+id/seg"
            android:layout_width="wrap_content"
            android:layout_height="56px"
            android:layout_marginLeft="20px"
            android:background="@drawable/seg_bg"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/tabFavorite"
                style="@style/SegItem"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/tab_favorite" />

            <View
                android:layout_width="1px"
                android:layout_height="match_parent"
                android:background="@color/line2" />

            <RadioButton
                android:id="@+id/tabAll"
                style="@style/SegItem.Right"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/tab_all" />
        </RadioGroup>

        <View
            android:layout_width="0dp"
            android:layout_height="1px"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnClosePanel"
            style="@style/Btn.Icon"
            android:layout_width="56px"
            android:layout_height="56px"
            android:contentDescription="@string/close_list"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40px"
        android:background="@drawable/line_bottom"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="24px"
        android:paddingRight="24px">

        <TextView
            style="@style/ColHead"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/col_app" />

        <TextView
            style="@style/ColHead"
            android:layout_width="130px"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/col_favorite" />

        <TextView
            style="@style/ColHead"
            android:layout_width="220px"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/col_quick" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/appList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@null"
            android:fastScrollEnabled="true"
            android:paddingLeft="14px"
            android:paddingTop="8px"
            android:paddingRight="14px"
            android:paddingBottom="8px"
            android:scrollbars="vertical" />

        <TextView
            android:id="@+id/emptyHint"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingLeft="40px"
            android:paddingRight="40px"
            android:text="@string/empty_favorite"
            android:textColor="@color/t3"
            android:textSize="24px"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="56px"
        android:background="@drawable/line_top"
        android:gravity="center_vertical"
        android:paddingLeft="28px"
        android:paddingRight="28px"
        android:text="@string/list_hint"
        android:textColor="@color/t3"
        android:textSize="21px" />
</LinearLayout>
