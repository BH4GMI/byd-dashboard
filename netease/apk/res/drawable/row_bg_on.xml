<?xml version="1.0" encoding="utf-8"?>
<!--
  应用列表行 · 是当前一键启动目标。
  对应预览页 `.row.on`：accent 10% 底色 + 左侧 4px accent 竖条（竖条上下各内缩 16px）。

  竖条用 layer-list 的第二层画：`android:width` 定宽、`android:top/bottom` 内缩。
  预览页里竖条是 left:-4px（在行外），这里贴在行内左边缘 —— 行的左侧本来就是
  列表容器的 14px 内边距，两种画法在屏幕上落点相同，少一层负边距。
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ripple">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="8px" />
                    <solid android:color="@color/row_on" />
                </shape>
            </item>
            <item
                android:bottom="16px"
                android:top="16px"
                android:width="4px">
                <shape android:shape="rectangle">
                    <corners android:radius="2px" />
                    <solid android:color="@color/accent" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
