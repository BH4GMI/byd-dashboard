<?xml version="1.0" encoding="utf-8"?>
<!--
  普通按钮。对应预览页 `.btn`：panel2 底 + line2 描边 + 8px 圆角，无阴影、无全大写。

  ripple 而不是 selector(android:state_pressed)：涟漪会被裁到圆角内，
  是平台原生的按下反馈；用 selector 换一个纯色会在圆角外露出直角。
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ripple">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="8px" />
            <solid android:color="@color/panel2" />
            <stroke
                android:width="1px"
                android:color="@color/line2" />
        </shape>
    </item>
</ripple>
