<?xml version="1.0" encoding="utf-8"?>
<!--
  状态行圆点。对应预览页 `.dot`：11px 圆。
  底色写白、由代码 `setBackgroundTintList` 染成 ok/warn/danger/t3 ——
  四个颜色一份形状，避免为每个语义各写一个只有颜色不同的 drawable。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="#FFFFFFFF" />
</shape>
